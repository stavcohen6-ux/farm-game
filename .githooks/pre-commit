#!/usr/bin/env bash
# Regenerate cache-bust import map when game JS/CSS is part of the commit.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! git diff --cached --name-only | grep -qE '^(src/.*\.js|style\.css)$'; then
  exit 0
fi

./scripts/bust-cache.sh
git add index.html
